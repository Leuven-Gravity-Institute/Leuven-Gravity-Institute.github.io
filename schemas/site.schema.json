{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "site.schema.json",
    "title": "Site configuration",
    "type": "object",
    "required": ["site", "org"],
    "additionalProperties": false,
    "properties": {
        "site": {
            "type": "object",
            "required": ["url", "title", "pages"],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "short_title": {
                    "type": "string"
                },
                "tagline": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "accent": {
                    "type": "string"
                },
                "logo": {
                    "type": "string",
                    "description": "Site-root path to the logo, used in the masthead and as the favicon."
                },
                "groups": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Research groups covered by this site; `group` in people.yaml references these ids.",
                    "items": {
                        "type": "object",
                        "required": ["id", "name"],
                        "additionalProperties": false,
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                            },
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "lead": {
                                "type": "string",
                                "description": "Person id of the group leader."
                            }
                        }
                    }
                },
                "pages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/page"
                    }
                }
            }
        },
        "org": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "headline": {
                    "type": "string"
                },
                "intro": {
                    "type": "string"
                },
                "about": {
                    "type": "string"
                },
                "affiliation": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                },
                "facts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "additionalProperties": false,
                        "properties": {
                            "label": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                "links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/link"
                    }
                }
            }
        }
    },
    "$defs": {
        "page": {
            "type": "object",
            "required": ["slug", "label", "sections"],
            "additionalProperties": false,
            "properties": {
                "slug": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string"
                },
                "lead": {
                    "type": "string"
                },
                "nav": {
                    "type": "boolean"
                },
                "sections": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "type": "string",
                                "minLength": 1
                            },
                            {
                                "type": "object",
                                "required": ["name"],
                                "additionalProperties": false,
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "preview": {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        },
        "link": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
                "label": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}
