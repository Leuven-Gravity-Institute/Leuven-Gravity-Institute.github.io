{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "teaching.schema.json",
    "title": "Teaching",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["kind", "title"],
                "additionalProperties": false,
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": ["course", "lecture series", "project"]
                    },
                    "title": { "type": "string", "minLength": 1 },
                    "code": { "type": "string" },
                    "institution": { "type": "string" },
                    "term": { "type": "string" },
                    "people": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "summary": { "type": "string" },
                    "url": { "type": "string" }
                }
            }
        }
    }
}
