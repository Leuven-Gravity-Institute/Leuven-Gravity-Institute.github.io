{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "publications.schema.json",
    "title": "Publications",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                    "include": { "type": "boolean" },
                    "highlight": { "type": "boolean" },
                    "title": { "type": "string", "minLength": 1 },
                    "authors": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "venue": { "type": "string" },
                    "year": { "type": ["integer", "null"] },
                    "date": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
                        "description": "Publication date as known; ORCID often supplies only a year."
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "journal",
                            "preprint",
                            "conference",
                            "thesis",
                            "book",
                            "chapter",
                            "dataset",
                            "software",
                            "report",
                            "other"
                        ]
                    },
                    "doi": { "type": "string" },
                    "arxiv": { "type": "string" },
                    "url": { "type": "string" },
                    "key": {
                        "type": "string",
                        "description": "Stable identity (doi:, arxiv:, or title:). Present on synced entries only."
                    },
                    "source": { "type": "string", "enum": ["orcid", "manual"] },
                    "members": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Ids of the group members credited; drives the per-member publication pages."
                    },
                    "author_count": { "type": "integer", "minimum": 0 },
                    "collaboration": { "type": "boolean" },
                    "note": { "type": "string" },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["label", "url"],
                            "additionalProperties": false,
                            "properties": {
                                "label": { "type": "string" },
                                "url": { "type": "string" }
                            }
                        }
                    }
                }
            }
        }
    }
}
