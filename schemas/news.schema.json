{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "news.schema.json",
    "title": "News",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["date", "body"],
                "additionalProperties": false,
                "properties": {
                    "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "title": { "type": "string" },
                    "body": { "type": "string", "minLength": 1 },
                    "url": { "type": "string" }
                }
            }
        }
    }
}
