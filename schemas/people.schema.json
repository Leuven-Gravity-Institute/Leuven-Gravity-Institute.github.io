{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "people.schema.json",
    "title": "People",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "slug", "name", "role", "category"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "name": { "type": "string", "minLength": 1 },
                    "role": { "type": "string", "minLength": 1 },
                    "category": { "type": "string", "minLength": 1 },
                    "status": {
                        "type": "string",
                        "enum": ["current", "alumni"]
                    },
                    "photo": { "type": "string" },
                    "email": { "type": "string" },
                    "orcid": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$",
                        "description": "ORCID iD; required for the publication sync to pick this person up."
                    },
                    "start": {
                        "type": "string",
                        "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
                        "description": "Date the person joined the group; bounds which publications count as the group's."
                    },
                    "end": {
                        "type": "string",
                        "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
                        "description": "Date the person left; omit while they are still here."
                    },
                    "interests": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "bio": { "type": "string" },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["label", "url"],
                            "additionalProperties": false,
                            "properties": {
                                "label": { "type": "string" },
                                "icon": { "type": "string" },
                                "url": { "type": "string" }
                            }
                        }
                    }
                },
                "dependentRequired": { "orcid": ["start"] }
            }
        }
    }
}
