{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "join.schema.json",
    "title": "Open positions",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "intro": { "type": "string" },
        "closing": { "type": "string" },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["title", "level", "summary"],
                "additionalProperties": false,
                "properties": {
                    "title": { "type": "string", "minLength": 1 },
                    "level": { "type": "string", "minLength": 1 },
                    "open": { "type": "boolean" },
                    "deadline": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "summary": { "type": "string", "minLength": 1 },
                    "contact": { "type": "string" },
                    "url": { "type": "string" }
                }
            }
        }
    }
}
