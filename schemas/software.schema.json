{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "software.schema.json",
    "title": "Software and data releases",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "category", "kind", "summary"],
                "additionalProperties": false,
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "category": { "type": "string", "minLength": 1 },
                    "kind": {
                        "type": "string",
                        "enum": ["software", "dataset"]
                    },
                    "summary": { "type": "string", "minLength": 1 },
                    "role": { "type": "string" },
                    "license": { "type": "string" },
                    "people": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["label", "url"],
                            "additionalProperties": false,
                            "properties": {
                                "label": { "type": "string" },
                                "url": { "type": "string" }
                            }
                        }
                    }
                }
            }
        }
    }
}
